{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${AS_RCON_VERSION}",
	"name": "as_rcon",
	"description": "Admin rcon: the console command 'mm_rcon <command line>' lets an admin (or the server console) execute any server command through the engine, and reports every use to the other plugins through admin_system::SendAction(slot, \"rcon\", command). Requires the @admin/rcon permission from the admin_system core; the server console (-1) always passes. A port of the Metamod:Source module 'Rcon' of the Pisex cs2-admin_system plugin.",
	"author": "Pisex, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/as_rcon",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "admin_system",
			"constraints": ">=1.0.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	],
	"methods": []
}
